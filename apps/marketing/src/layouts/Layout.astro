---
import "../styles/fonts.css";
interface Props { title?: string; description?: string; pageClass?: string; }
const { title = "Puff Collab", description = "Work on code with agents and coordinate shared threads with your team.", pageClass } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <div class={pageClass}>
      <header><a class="brand" href="/"><img src="/logo.svg" alt="" width="40" height="40" />Puff Collab</a><a href="/download">Get started</a></header>
      <main><slot /></main>
      <footer>Built on <a href="https://github.com/pingdotgg/t3code">T3 Code</a>. <a href="https://github.com/uzgorenm/puffcollab">Source code</a> · <a href="/legal">License and privacy</a></footer>
    </div>
  </body>
</html>
<style is:global>
  :root { color-scheme: dark; font-family: "DM Sans", system-ui, sans-serif; background: #0d1820; color: #fff8ee; }
  body { margin: 0; } header, main, footer { max-width: 1000px; margin: auto; padding: 32px 24px; }
  header { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-size: 22px; font-weight: 600; text-decoration: none; }
  a { color: #ffb56c; } a:focus-visible { outline: 2px solid #ffb56c; outline-offset: 5px; }
  h1 { font-size: clamp(36px, 6vw, 64px); line-height: 1.1; max-width: 800px; letter-spacing: -0.04em; }
  h2 { margin-top: 48px; } p, li { max-width: 720px; line-height: 1.65; color: #cfdbde; }
  .action { display: inline-block; padding: 14px 20px; background: #ff9438; color: #102c38; border-radius: 10px; text-decoration: none; font-weight: 600; }
  pre { overflow: auto; padding: 20px; background: #19303b; border-radius: 10px; line-height: 1.7; } footer { font-size: 14px; color: #9ab0b8; }
</style>
